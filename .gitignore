# data — pinned by hash in configs, never committed
data/raw/*
data/processed/*
!data/**/.gitkeep
# the manifest is the record of what was pinned, so it is kept
!data/processed/manifest.json
results/raw/*
!results/raw/.gitkeep
# figures are small, reproducible and belong with the text that cites them
!results/figures/*.pdf
!results/figures/*.png
*.onnx
*.tflite
checkpoints/
# fine-tuned graphs are 256 MB each; the probability matrices travel instead
models/*
!models/manifest_*.json
# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/
# os / editors
.DS_Store
.vscode/
.cursor/

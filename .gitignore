# data — pinned by hash in configs, never committed
data/raw/*
data/processed/*
!data/**/.gitkeep
# the manifest is the record of what was pinned, so it is kept
!data/processed/manifest.json
results/raw/*
!results/raw/.gitkeep
*.onnx
*.tflite
checkpoints/
# python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
*.egg-info/
# os / editors
.DS_Store
.vscode/
.cursor/
